{
  "name": "lucifer-database-x-replica",
  "private": true,
  "version": "1.0.0",
  "description": "Static-feel replica of Lucifer Database X — same structure and verified datasets, entirely new clean UI with light and dark themes.",
  "license": "MIT",
  "author": "Lucifer Open Source <ailuciferbaba@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "npx -y @lhci/cli autorun"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.9"
  }
}
